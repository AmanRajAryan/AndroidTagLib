  command = $PRE_LINK && /data/user/0/com.tom.rv2ide/files/home/android-sdk/cmake/4.1.2/bin/cmake -E rm -f $TARGET_FILE && /data/user/0/com.tom.rv2ide/files/home/android-sdk/ndk/29.0.14033849/toolchains/llvm/prebuilt/linux-arm64/bin/llvm-ar qc $TARGET_FILE $LINK_FLAGS $in && /data/user/0/com.tom.rv2ide/files/home/android-sdk/ndk/29.0.14033849/toolchains/llvm/prebuilt/linux-arm64/bin/llvm-ranlib $TARGET_FILE && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /data/user/0/com.tom.rv2ide/files/home/android-sdk/cmake/4.1.2/bin/cmake --regenerate-during-build -S/storage/emulated/0/AndroidIDEProjects/AndroidTagLib/library -B/storage/emulated/0/AndroidIDEProjects/AndroidTagLib/library/.cxx/Debug/6d6u3a5p/arm64-v8a
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /data/user/0/com.tom.rv2ide/files/home/android-sdk/cmake/4.1.2/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /data/user/0/com.tom.rv2ide/files/home/android-sdk/cmake/4.1.2/bin/ninja -t targets
  description = All primary targets available:

